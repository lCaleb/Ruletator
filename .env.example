# URL definitiva (https://tu-proyecto.vercel.app o dominio propio).
# En Vercel se usa VERCEL_PROJECT_PRODUCTION_URL si queda vacía.
NEXT_PUBLIC_SITE_URL=https://ruletator.pages.dev
NEXT_PUBLIC_CONTACT_EMAIL=

# Banners ficticios para grabaciones, sin servicios externos. AdSense tiene prioridad.
NEXT_PUBLIC_DEMO_ADS=true

# ID real de tu cuenta de AdSense. Permite verificar el sitio sin servir anuncios.
# Al cambiar estos valores hay que redesplegar.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Activar tras la aprobación, revisar privacidad y configurar el mensaje
# de consentimiento/CMP certificada en AdSense donde corresponda.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ID de cada bloque adaptable creado en AdSense. Puedes usar solo algunos.
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_PANEL_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_PANEL_BOTTOM=
